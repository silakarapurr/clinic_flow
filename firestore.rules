rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // KVKK and Multi-tenant Security Rules
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isClinicMember(clinicId) {
      return isAuthenticated() && (
        request.auth.token.clinicId == clinicId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserDoc().clinicId == clinicId)
      );
    }
    
    function isAdmin(clinicId) {
      return isClinicMember(clinicId) && getUserDoc().role == 'admin';
    }

    // Direct user profiles mapped by auth uid
    match /users/{userId} {
      allow read, write: if true;
    }

    // Approved clinic users registry for mobile app login verification
    match /approved_users/{docId} {
      allow read, write: if true;
    }

    // Public clinic registration applications
    match /registration_applications/{appId} {
      allow read, write: if true;
    }

    // Audit log stream of registration events
    match /registration_events/{eventId} {
      allow read, write: if true;
    }

    // Clinic-scoped multi-tenant data
    match /clinics/{clinicId} {
      allow read, write: if true;

      match /users/{userId} {
        allow read, write: if true;
      }

      match /doctors/{doctorId} {
        allow read, write: if true;
      }

      match /patients/{patientId} {
        allow read, write: if true;
      }

      match /appointments/{appointmentId} {
        allow read, write: if true;
      }
    }
  }
}
